# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"


# Yandex GPT (Yandex Cloud Foundation Models):
# Used as fallback when Gemini models are unavailable (e.g. error 400, 429, 503).
# Create an API key in Yandex AI Studio (https://console.yandex.cloud/ -> AI Studio -> API keys).
YANDEX_GPT_API_KEY=""
# Folder ID used to build modelUri (gpt://<folder_id>/yandexgpt-lite).
# In CI it is injected automatically from tokens.yc-token.folder_id.
YANDEX_GPT_FOLDER_ID=""
YANDEX_GPT_MODEL="yandexgpt-lite"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Sheets Configuration
# VibeCoffeItems table: Stores coffee items (name, country, flavor profile, price)
GOOGLE_SHEETS_COFFEE_ITEMS_ID="1VynuGR-LVzYYfLHtMqlWTvPUpZoaskWp_kNF7Z7TgM8"

# Service Account credentials for VibeCoffeeFAQ and VibeCoffeeLogs
# If not provided, the backend seamlessly uses the built-in active store FAQ and audit store.
GOOGLE_SHEETS_FAQ_ID="VibeCoffeeFAQ"
GOOGLE_SHEETS_LOGS_ID="VibeCoffeeLogs"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_SHEETS_API_KEY=""
